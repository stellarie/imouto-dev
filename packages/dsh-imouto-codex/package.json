        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format-catalog": "link:../../../deepseek-harness/packages/session/session-format-catalog",
    "undici": "8.10.0"
  },
